:: Widgets [widget]
<<widget "statChange">><<set _stat to _args[0]>><<set _amount to _args[1]>><<set _current to State.variables[_stat]>><<if _amount > 0>><<if _current >= 90>><<set _amount to Math.ceil(_amount * 0.25)>><<elseif _current >= 75>><<set _amount to Math.ceil(_amount * 0.5)>><<elseif _current >= 50>><<set _amount to Math.ceil(_amount * 0.75)>><</if>><</if>><<set State.variables[_stat] to Math.max(0, Math.min(100, _current + _amount))>><<set _label to _stat.charAt(0).toUpperCase() + _stat.slice(1)>><span class="stat-change"><<print _label>>: <<if _amount > 0>>+<</if>><<print _amount>></span><</widget>>

<<widget "addItem">><<if !$inventory.includes(_args[0])>><<run $inventory.push(_args[0])>><span class="item-gained">Acquired: <<print _args[0]>></span><</if>><</widget>>

<<widget "hasItem">><<set _result to $inventory.includes(_args[0])>><</widget>>

<<widget "equipOutfit">><<set $equippedOutfit to _args[0]>><</widget>>

<<widget "statSummary">><div class="stat-summary"><strong>End of Day <<print $day>></strong><ul><li>Feminization: <<print $feminization>></li><li>Obedience: <<print $obedience>></li><li>Embarrassment: <<print $embarrassment>></li><li>Arousal: <<print $arousal>></li><li>Confidence: <<print $confidence>></li><li>Resistance: <<print $resistance>></li><li>Money: $<<print $money>></li></ul></div><</widget>>

<<widget "startDay">><<set _mainCount to _args[0]>><<set _sideCount to _args[1]>><<if $timeBudgetDay isnot $day>><<set _totalUnits to _mainCount + Math.ceil(_sideCount / 2)>><<set $minutesPerTask to Math.round(((1380 - 420) / _totalUnits) / 5) * 5>><<set $gameMinutes to 420>><<set $timeBudgetDay to $day>><</if>><</widget>>

<<widget "spendTime">><<set $gameMinutes to $gameMinutes + (_args[0] * $minutesPerTask)>><<if $gameMinutes >= 1200>><<set $phase to "night">><<elseif $gameMinutes >= 1020>><<set $phase to "evening">><<elseif $gameMinutes >= 720>><<set $phase to "afternoon">><<else>><<set $phase to "morning">><</if>><</widget>>

<<widget "formatClock">><<set _m to _args[0]>><<set _h24 to Math.floor(_m / 60) % 24>><<set _min to _m % 60>><<set _ampm to _h24 >= 12 ? "PM" : "AM">><<set _h12 to _h24 % 12>><<if _h12 is 0>><<set _h12 to 12>><</if>><<print _h12>>:<<print _min < 10 ? "0" + _min : _min>> <<print _ampm>><</widget>>

<<widget "taskEntry">><<set _label to _args[0]>><<set _target to _args[1]>><<set _cost to _args[2]>><<set _done to _args[3]>><<set _locked to _args[4]>><<set _hint to _args[5] || "">><<if _done>><li class="task-done">&#10003; <<print _label>></li><<elseif _locked>><li class="task-locked">&#128274; <<print _label>> <em><<print _hint>></em></li><<else>><li class="task-available"><<link _label _target>><</link>></li><</if>><</widget>>

<<widget "homeTasks">><<if $day is 1>><ul><<taskEntry "Help Evelyn with chores" "Day1_Morning_A" 1 $evelynChoresDay1 false "">><<taskEntry "Laze around the house" "Day1_Morning_B" 1 $lazedDay1 false "">><<taskEntry "Check job listings online" "Day1_Afternoon_C" 1 $cafeJobApplied false "">><<taskEntry "Have dinner with Evelyn and Lily" "Day1_Evening_A" 1 $dinnerDay1 false "">><<taskEntry "Call Chloe" "Day1_Evening_B" 1 $chloePhoneCall `!$chloeVisitedDay1` "(visit her first)">><<taskEntry "Play video games alone" "Day1_Evening_C" 1 $gamesDay1 false "">><<taskEntry "Look around the house" "Day1_SQ_HouseTour" 1 $houseTourSeen false "">></ul><<elseif $day is 2>><ul><<taskEntry "Help Evelyn with her morning task" "Day2_Morning_A" 1 `$yesMaamAccepted || $evelynDishesDay2` false "">><<taskEntry "Sleep in" "Day2_Morning_C" 1 $sleptInDay2 false "">><<taskEntry "Hang out in Lily's room" "Day2_Afternoon_C" 1 $lilyNailsDay2 false "">><<taskEntry "Have dinner with Evelyn and Lily" "Day2_Evening_A" 1 $dinnerDay2 false "">><<taskEntry "Text Chloe goodnight" "Day2_Evening_B" 1 $chloeGoodnightDay2 false "">><<taskEntry "Lily's room, round two" "Day2_Evening_C" 1 $prettyboyKaiSeen `!$toenailsPainted` "(paint her nails first)">><<taskEntry "Look through Evelyn's closet" "Day2_SQ_Closet" 1 $ridingCropSeen `!$yesMaamAccepted` "(help Evelyn this morning first)">><<taskEntry "Check your wardrobe" "Day2_SQ_WardrobeAudit" 1 $wardrobeAuditDone false "">></ul><<elseif $day is 3>><ul><<taskEntry "Help Evelyn with her morning task" "Day3_Morning_B" 1 $evelynClosetDay3 false "">><<taskEntry "Help Lily with photography" "Day3_Morning_C" 1 $lilyPhotographyDone false "">><<taskEntry "Have dinner with Evelyn and Lily" "Day3_Evening_A" 1 $dinnerDay3 false "">><<taskEntry "Call Chloe" "Day3_Evening_B" 1 $chloeCallDay3 false "">><<taskEntry "See what Lily wants" "Day3_Evening_C" 1 $lilyPantiesDay3 false "">></ul><</if>><</widget>>

<<widget "neighborhoodTasks">><<if $day is 1>><ul><<taskEntry "Go for a jog" "Day1_Morning_C" 1 $joggedDay1 false "">><<taskEntry "Explore the neighborhood" "Day1_Afternoon_B" 1 $neighborhoodExplored false "">><<taskEntry "Visit Ali's Corner Store" "Day1_SQ_Ali" 1 $aliMet `!$neighborhoodExplored` "(explore the neighborhood first)">><<taskEntry "Sit with Mrs. Delgado" "Day1_SQ_Delgado" 1 $delgadoMet `!$neighborhoodExplored` "(explore the neighborhood first)">></ul><<elseif $day is 2>><ul><<taskEntry "Go for a jog (pass Sophia's house)" "Day2_Morning_B" 1 $joggedDay2 false "">><<taskEntry "Chat with Ali" "Day2_SQ_Ali" 1 $aliCrosswordDay2 false "">></ul><<elseif $day is 3>><ul><<taskEntry "Visit Chloe at the park" "Day3_Afternoon_A" 1 $chloeParkDay3 false "">><<taskEntry "Chat with Ali" "Day3_SQ_Ali" 1 $aliCrosswordDay3 false "">></ul><</if>><</widget>>

<<widget "chloeTasks">><<if $day is 1>><ul><<taskEntry "Visit Chloe" "Day1_Afternoon_A" 1 $chloeVisitedDay1 false "">></ul><<elseif $day is 2>><ul><<taskEntry "Visit Chloe's apartment" "Day2_Afternoon_A" 1 $chloeVisitedDay2 false "">></ul><<elseif $day is 3>><p class="nothing-here">Nothing to do here today &mdash; Chloe's out and about.</p><</if>><</widget>>

<<widget "townTasks">><<if $day is 2>><ul><<taskEntry "Explore town" "Day2_Afternoon_B" 1 $townExplored false "">></ul><<elseif $day is 3>><ul><<taskEntry "First cafe shift" "Day3_Morning_A" 1 $cafeJobStarted `!$cafeJobApplied` "(apply for the job first)">><<taskEntry "Visit Kinky Kitty" "Day3_Afternoon_B" 1 $ravenMet false "">><<taskEntry "Walk the mall area" "Day3_Afternoon_C" 1 $mallWalkDay3 false "">><<taskEntry "Chat with Mrs. Okonkwo" "Day3_SQ_Okonkwo" 1 $okonkwoMet `!$cafeJobStarted` "(work a cafe shift first)">><<taskEntry "Try on your uniform" "Day3_SQ_Uniform" 1 $cafeUniformTried `!$cafeJobStarted` "(work a cafe shift first)">></ul><</if>><</widget>>

<<widget "locationTasks">><<set _loc to _args[0]>><<if _loc is "home">><<homeTasks>><<elseif _loc is "neighborhood">><<neighborhoodTasks>><<elseif _loc is "chloe">><<chloeTasks>><<elseif _loc is "town">><<townTasks>><</if>><</widget>>

<<widget "lateWarning">><<if $gameMinutes < 1380 and ($gameMinutes + $minutesPerTask) >= 1380>><p class="late-warning">&#9888;&#65039; It's getting late. One more thing and I'll need to call it a night.</p><</if>><</widget>>

<<widget "dayPlanContent">><div class="day-plan"><<if $day is 1>><h4>&#127968; Home</h4><<homeTasks>><h4>&#127961;&#65039; Neighborhood</h4><<neighborhoodTasks>><h4>&#128139; Chloe's Apartment</h4><<chloeTasks>><<elseif $day is 2>><h4>&#127968; Home</h4><<homeTasks>><h4>&#127961;&#65039; Neighborhood</h4><<neighborhoodTasks>><h4>&#128139; Chloe's Apartment</h4><<chloeTasks>><h4>&#127970; Downtown</h4><<townTasks>><<elseif $day is 3>><h4>&#127968; Home</h4><<homeTasks>><h4>&#127961;&#65039; Neighborhood</h4><<neighborhoodTasks>><h4>&#128139; Chloe's Apartment</h4><<chloeTasks>><h4>&#127970; Downtown</h4><<townTasks>><</if>></div><</widget>>

<<widget "locationMap">>
<<set _loc to _args[0]>>
<<set _homeActive to _loc === 'home' ? 'map-node-active' : ''>>
<<set _neighborhoodActive to _loc === 'neighborhood' ? 'map-node-active' : ''>>
<<set _chloeActive to _loc === 'chloe' ? 'map-node-active' : ''>>
<<set _townUnlocked to $day >= 2>>
<<set _townClass to _townUnlocked ? (_loc === 'town' ? 'map-node-active' : '') : 'map-node-locked'>>
<<set _townEdgeClass to _townUnlocked ? 'map-edge' : 'map-edge map-edge-locked'>>
<<set _townIcon to _townUnlocked ? '\u{1F3E2}' : '\u{1F512}'>>
<<set _townLabel to _townUnlocked ? 'Downtown' : '???'>>
<<set _caption to _loc === 'home' ? 'You are home.' : (_loc === 'neighborhood' ? 'You\'re out in the neighborhood.' : (_loc === 'chloe' ? 'You\'re at Chloe\'s apartment.' : (_loc === 'town' ? 'You\'re downtown.' : '')))>>
<<set _subnodes to $day >= 3 ? ('<line x1="370" y1="90" x2="290" y2="190" class="map-subedge"></line><line x1="370" y1="90" x2="370" y2="220" class="map-subedge"></line><line x1="370" y1="90" x2="450" y2="190" class="map-subedge"></line><g class="map-node map-subnode"><circle cx="290" cy="190" r="18"></circle><text x="290" y="196" text-anchor="middle" class="map-icon map-subicon">&#9749;</text><text x="290" y="224" text-anchor="middle" class="map-label map-sublabel">Cafe</text></g><g class="map-node map-subnode"><circle cx="370" cy="220" r="18"></circle><text x="370" y="226" text-anchor="middle" class="map-icon map-subicon">&#128049;</text><text x="370" y="254" text-anchor="middle" class="map-label map-sublabel">Kinky Kitty</text></g><g class="map-node map-subnode"><circle cx="450" cy="190" r="18"></circle><text x="450" y="196" text-anchor="middle" class="map-icon map-subicon">&#128722;</text><text x="450" y="224" text-anchor="middle" class="map-label map-sublabel">Mall</text></g>') : ''>>
<<set _svg to '<div class="location-map"><svg viewBox="0 0 480 270" xmlns="http://www.w3.org/2000/svg"><line x1="70" y1="90" x2="220" y2="90" class="map-edge"></line><line x1="220" y1="90" x2="370" y2="90" class="' + _townEdgeClass + '"></line><line x1="70" y1="90" x2="70" y2="210" class="map-edge"></line>' + _subnodes + '<g class="map-node ' + _homeActive + '"><circle cx="70" cy="90" r="28"></circle><text x="70" y="97" text-anchor="middle" class="map-icon">&#127968;</text><text x="70" y="134" text-anchor="middle" class="map-label">Home</text></g><g class="map-node ' + _neighborhoodActive + '"><circle cx="220" cy="90" r="28"></circle><text x="220" y="97" text-anchor="middle" class="map-icon">&#127961;&#65039;</text><text x="220" y="134" text-anchor="middle" class="map-label">Neighborhood</text></g><g class="map-node ' + _chloeActive + '"><circle cx="70" cy="210" r="25"></circle><text x="70" y="217" text-anchor="middle" class="map-icon">&#128139;</text><text x="70" y="251" text-anchor="middle" class="map-label">Chloe\'s</text></g><g class="map-node ' + _townClass + '"><circle cx="370" cy="90" r="28"></circle><text x="370" y="97" text-anchor="middle" class="map-icon">' + _townIcon + '</text><text x="370" y="52" text-anchor="middle" class="map-label">' + _townLabel + '</text></g></svg><p class="map-caption">' + _caption + '</p></div>'>>
<<print _svg>>
<</widget>>
